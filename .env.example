PORT=8787
VITE_NEXT_TRACK_HORIZON_MS=50000
VITE_PROGRAM_TRACK_DURATION_MS=180000

# "on" writes a local NDJSON file. "stdout" writes NDJSON to standard output.
# Cloud Run uses stdout by default when this value is not set.
ROBOT_RADIO_DEBUG_LOG=on
# ROBOT_RADIO_DEBUG_LOG_DIR=/absolute/path/to/debug-logs
# ROBOT_RADIO_WEB_DIST_DIR=/absolute/path/to/apps/web/dist

# Select every adapter at once. An individual setting below overrides this value.
PROVIDER_STACK=mock
# LLM_PROVIDER=mock
# MUSIC_PROVIDER=mock
# LYRIA_PROVIDER=mock
# TTS_PROVIDER=mock

# Required when any selected provider is "google".
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.7-flash
GEMINI_FAST_LLM_MODEL=gemini-3.5-flash-lite
GEMINI_FAST_LLM_THINKING_LEVEL=minimal
GEMINI_MUSIC_MODEL=lyria-3-pro-preview
GEMINI_LYRIA_REALTIME_MODEL=models/lyria-realtime-exp
# The current SDK reaches the experimental music WebSocket through v1alpha.
GEMINI_LYRIA_API_VERSION=v1alpha
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
# "stream" uses generateContentStream. "batch" waits for the complete spoken line.
GEMINI_TTS_DELIVERY=stream
# The server uses its packaged FFmpeg binary when this value is not set.
# FFMPEG_PATH=/absolute/path/to/ffmpeg

GEMINI_LLM_TIMEOUT_MS=30000
GEMINI_MUSIC_TIMEOUT_MS=600000
GEMINI_LYRIA_CONNECT_TIMEOUT_MS=20000
GEMINI_TTS_TIMEOUT_MS=120000

MOCK_URGENCY_LATENCY_MS=180
MOCK_PLANNER_LATENCY_MS=850
MOCK_MUSIC_STARTUP_MS=450
MOCK_LYRIA_STARTUP_MS=220
MOCK_TTS_STARTUP_MS=180

# Optional failure and starvation controls, in milliseconds.
# MOCK_MUSIC_FAIL_AFTER_MS=10000
# MOCK_MUSIC_STARVE_AT_MS=6000
# MOCK_MUSIC_STARVE_FOR_MS=5000
# MOCK_LYRIA_FAIL_AFTER_MS=10000
# MOCK_TTS_FAIL_AFTER_MS=1000
