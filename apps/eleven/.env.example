# Vercel-ready live configuration.
# Import this file into Vercel, then replace the three empty secret values.
# For free local development, set PROVIDER_STACK=mock and leave the provider keys empty.

PROVIDER_STACK=eleven
DEMO_PASSWORD=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ROBOT_RADIO_DEBUG_LOG=stdout

# Live provider selection. These overrides are not required for the complete ElevenLabs stack.
# LLM_PROVIDER=openai
# MUSIC_PROVIDER=eleven
# TRANSITION_PROVIDER=eleven
# TTS_PROVIDER=eleven

OPENAI_LLM_MODEL=gpt-5.6-luna
OPENAI_FAST_LLM_MODEL=gpt-5.6-luna
OPENAI_FAST_SERVICE_TIER=priority
OPENAI_LLM_TIMEOUT_MS=45000
# OPENAI_BASE_URL=https://api.openai.com/v1

ELEVENLABS_MUSIC_MODEL=music_v2
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Blondie: a female London voice with a professional radio-announcer and DJ tone.
ELEVENLABS_VOICE_ID=st7NwhTPEzqo2riw7qWC
ELEVENLABS_MUSIC_DETAILED_STREAM=true
ELEVENLABS_MUSIC_TIMEOUT_MS=240000
ELEVENLABS_MUSIC_HTTP_RETRIES=1
ELEVENLABS_MUSIC_RETRY_DELAY_MS=350
ELEVENLABS_TTS_TIMEOUT_MS=60000
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io

# Local-only values. Vercel supplies its own port and uses same-origin routing.
# PORT=8787
# VITE_NEXT_TRACK_HORIZON_MS=50000
# VITE_PROGRAM_TRACK_DURATION_MS=180000
# ROBOT_RADIO_DEBUG_LOG=on
# ROBOT_RADIO_DEBUG_LOG_DIR=/absolute/path/to/debug-logs
# ROBOT_RADIO_WEB_DIST_DIR=/absolute/path/to/apps/eleven/web/dist
# FFMPEG_PATH=/absolute/path/to/ffmpeg

# Optional mock timing and failure controls, in milliseconds.
# MOCK_URGENCY_LATENCY_MS=180
# MOCK_PLANNER_LATENCY_MS=850
# MOCK_MUSIC_STARTUP_MS=450
# MOCK_TTS_STARTUP_MS=180
# MOCK_MUSIC_FAIL_AFTER_MS=10000
# MOCK_MUSIC_STARVE_AT_MS=6000
# MOCK_MUSIC_STARVE_FOR_MS=5000
# MOCK_TTS_FAIL_AFTER_MS=1000
