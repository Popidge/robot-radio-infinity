{
  "name": "@robot-radio/eleven-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../../.env src/index.ts",
    "profile:eleven-music": "tsx --env-file-if-exists=../../../.env src/profiles/eleven-music.ts",
    "profile:google-audio": "tsx --env-file-if-exists=../../../.env src/profiles/google-audio.ts",
    "profile:google-tts": "tsx --env-file-if-exists=../../../.env src/profiles/google-tts.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@robot-radio/eleven-shared": "*",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.23.13",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
